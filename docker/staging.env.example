# ============================================================
# Clew: STAGING environment (same EC2 server as production)
#
# Copy to /home/ubuntu/abuse-staging/.env (backend) and fill the values.
# This file lists only what differs from .env.example, plus the settings that
# MUST be different from production so the two stacks cannot touch each other.
# Everything not listed here follows .env.example.
#
# The frontend file is /home/ubuntu/abuse-staging/frontend/.env.local, see the
# last section.
# ============================================================

DEBUG=0

# ------------------------------------------------------------
# ISOLATION: these four lines are what keep staging away from production
# ------------------------------------------------------------

# Its own database and its own role. Never the production database.
#   sudo -u postgres psql -c "CREATE ROLE clew_staging LOGIN PASSWORD '...';"
#   sudo -u postgres psql -c "CREATE DATABASE clew_staging OWNER clew_staging;"
DATABASE_URL=postgresql://clew_staging:your-staging-db-password@localhost:5432/clew_staging

# Redis database index 1 (production uses 0). The rate limiter, the Celery
# broker and result backend, the LTM state and the task-run records all read this
# one URL, so one index separates all of them.
REDIS_URL=redis://localhost:6379/1

# Its own secrets. A staging token must never verify on production and the
# other way round. Generate fresh values, do not copy the production ones.
JWT_SECRET=generate-a-new-one-openssl-rand-hex-64
TOTP_ENCRYPTION_KEY=generate-a-new-fernet-key

# Staging hosts (see docker/nginx.staging.conf).
DASHBOARD_URL=https://stg-dashboard.clewsec.com
HOME_URL=https://stg.clewsec.com
COOKIE_DOMAIN=
LEGACY_COOKIE_DOMAIN=

# ------------------------------------------------------------
# NO REAL SIDE EFFECTS
# ------------------------------------------------------------

# Print emails to the log instead of sending them.
LOG_EMAILS=1
RESEND_API_KEY=
RESEND_SEGMENT_ID=

# Leave blank: staging does no WAF blocking and writes no S3 backups.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CLEW_AWS_ACCOUNT_ID=

# No real LLM calls, no production heartbeat.
LLM_ENABLED=false
GROQ_API_KEY=
CRONITOR_URL=

# Cloudflare's public always-passes Turnstile test secret (pairs with the test
# site key in the frontend section below).
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ------------------------------------------------------------
# RAZORPAY: TEST MODE ONLY
# ------------------------------------------------------------

# Test keys (rzp_test_...), never live. Test-mode webhook URL in the Razorpay
# dashboard: https://stg-api.clewsec.com/billing/razorpay/webhook, events
# payment.captured, payment.failed and refund.processed, with its own signing
# secret.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Workers
CELERY_CONCURRENCY=2

# ============================================================
# FRONTEND: /home/ubuntu/abuse-staging/frontend/.env.local
# (NEXT_PUBLIC_* values are baked at build time: set them BEFORE `npm run build`)
# ============================================================
#
# NEXT_PUBLIC_API_URL=/api
# NEXT_PUBLIC_SITE_URL=https://stg.clewsec.com
# NEXT_PUBLIC_DASHBOARD_URL=https://stg-dashboard.clewsec.com
# DASHBOARD_HOST=stg-dashboard.clewsec.com
# INTERNAL_HOST=stg-internal.clewsec.com
# HOME_URL=https://stg.clewsec.com
# API_INTERNAL_URL=http://127.0.0.1:8100
# JWT_SECRET=<the same value as the staging backend JWT_SECRET above>
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
