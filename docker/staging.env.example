# ============================================================
# Clew backend environment, STAGING (same EC2 server as production)
# Copy to /home/ubuntu/abuse-staging/.env. Lists only what differs from
# .env.example; anything not listed follows .env.example.
# Frontend: /home/ubuntu/abuse-staging/frontend/.env.local (last section).
# ============================================================

DEBUG=0

# ------------------------------------------------------------
# ISOLATION  (keeps staging away from production)
# ------------------------------------------------------------

# Its own database and role, never the production database.
#   sudo -u postgres psql -c "CREATE ROLE clew_staging LOGIN PASSWORD '...';"
#   sudo -u postgres psql -c "CREATE DATABASE clew_staging OWNER clew_staging;"
DATABASE_URL=postgresql://clew_staging:your-staging-db-password@localhost:5432/clew_staging

# Redis database 1 (production uses 0). One index separates the rate limiter,
# Celery and task state.
REDIS_URL=redis://localhost:6379/1

# Fresh secrets: a staging token must never verify on production, or the reverse.
JWT_SECRET=generate-a-new-one-openssl-rand-hex-64
TOTP_ENCRYPTION_KEY=generate-a-new-fernet-key

# Staging hosts (see docker/nginx.staging.conf).
DASHBOARD_URL=https://stg-dashboard.clewsec.com
HOME_URL=https://stg.clewsec.com
COOKIE_DOMAIN=
LEGACY_COOKIE_DOMAIN=

# ------------------------------------------------------------
# NO REAL SIDE EFFECTS
# ------------------------------------------------------------

# 1 prints emails to the log instead of sending.
LOG_EMAILS=1
RESEND_API_KEY=
RESEND_SEGMENT_ID=

# Blank: no WAF blocking, no S3 backups.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CLEW_AWS_ACCOUNT_ID=

# No LLM calls, heartbeats or analytics.
LLM_ENABLED=false
GROQ_API_KEY=
HEARTBEAT_URL=
BILLING_HEARTBEAT_URL=
POSTHOG_API_KEY=

# Cloudflare's public always-pass test secret. Pairs with the test site key below.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ------------------------------------------------------------
# BILLING: Razorpay (INR), TEST MODE ONLY
# ------------------------------------------------------------

# Test keys (rzp_test_...), never live. Test webhook URL in the Razorpay dashboard:
# https://stg-api.clewsec.com/billing/razorpay/webhook
# Events: payment.captured, payment.failed, refund.processed. Use its own signing secret.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Referral credit, as a percent (0 to 100, default 100) of the referee's first payment.
# REFERRAL_CREDIT_PCT=100

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ------------------------------------------------------------
# CELERY WORKERS
# ------------------------------------------------------------

CELERY_CONCURRENCY=2

# ============================================================
# Frontend environment, STAGING: /home/ubuntu/abuse-staging/frontend/.env.local
# NEXT_PUBLIC_* values are baked at build time: set them before `npm run build`.
# ============================================================
#
# NEXT_PUBLIC_API_URL=/api
# NEXT_PUBLIC_SITE_URL=https://stg.clewsec.com
# NEXT_PUBLIC_DASHBOARD_URL=https://stg-dashboard.clewsec.com
# DASHBOARD_HOST=stg-dashboard.clewsec.com
# INTERNAL_HOST=stg-internal.clewsec.com
# HOME_URL=https://stg.clewsec.com
# API_INTERNAL_URL=http://127.0.0.1:8100
# JWT_SECRET=<the same value as the staging backend JWT_SECRET above>
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
