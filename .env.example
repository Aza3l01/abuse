# ============================================================
# Clew — environment variable reference
#
#   .env                → Python backend (FastAPI + Celery workers)
#   frontend/.env.local → Next.js frontend (NEXT_PUBLIC_* only)
#
# Copy this file:
#   cp .env.example .env          — never commit .env
#   cp .env.example frontend/.env.local  — then remove non-NEXT_PUBLIC vars
# ============================================================


# ------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------

DATABASE_URL=postgresql://clew:password@localhost:5432/clew


# ------------------------------------------------------------
# REDIS  (Celery broker + STM cache + rate limiting)
# ------------------------------------------------------------

REDIS_URL=redis://localhost:6379/0


# ------------------------------------------------------------
# AUTH
# ------------------------------------------------------------

# JWT — generate with: openssl rand -hex 64
JWT_SECRET=change-me-to-64-random-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Fernet key for encrypting TOTP secrets at rest
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=generate-a-fernet-key-here

# Frontend base URL (used to construct OAuth redirect URIs + email links)
FRONTEND_URL=http://localhost:3000

# Cookie domain — set this in production so cookies are shared across
# subdomains (e.g. api.clewsec.com and www.clewsec.com).
# Leave blank in local dev (localhost has no subdomains).
# Production value: .clewsec.com
COOKIE_DOMAIN=

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# GitHub OAuth — https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback

# Microsoft OAuth (Azure / Entra ID)
# Register at: https://portal.azure.com → Entra ID → App registrations
#   Supported account types: "Accounts in any organizational directory
#     (Any Azure AD tenant – Multitenant) and personal Microsoft accounts"
#   Add a Web redirect URI: https://api.clewsec.com/auth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8000/auth/microsoft/callback


# ------------------------------------------------------------
# AWS
# ------------------------------------------------------------

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1

# Resend — transactional email (verification, password reset, alerts)
# Get your API key from https://resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Set to 1 in local dev to print emails to the console instead of sending via Resend
LOG_EMAILS=


# ------------------------------------------------------------
# CELERY WORKERS
# ------------------------------------------------------------

# Number of concurrent worker processes (tune to CPU count × 2 on the worker host)
CELERY_CONCURRENCY=1

# Beat schedule is hard-coded to every 15 min (workers/beat.py).
# No additional env vars needed — workers use REDIS_URL above as the broker.


# ------------------------------------------------------------
# LOG INGESTION  (per-client values live in the DB, these are defaults)
# ------------------------------------------------------------

# S3 bucket where customer API Gateway / ALB logs are delivered
# CLIENT_S3_BUCKET=                # stored per-client in DB, not here


# ------------------------------------------------------------
# BLOCKING INTEGRATIONS
# ------------------------------------------------------------

# Cloudflare — stored per-client in DB (zone_id + token)
# CLOUDFLARE_API_TOKEN=            # stored per-client in DB, not here

# AWS WAF v2 — uses AWS_* credentials above
# WAF_IP_SET_ID=                   # stored per-client in DB, not here


# ------------------------------------------------------------
# THREAT INTELLIGENCE  (optional enrichment)
# ------------------------------------------------------------

ABUSEIPDB_API_KEY=                 # https://www.abuseipdb.com/register


# ------------------------------------------------------------
# FRONTEND  (frontend/.env.local)
# Only NEXT_PUBLIC_* vars are exposed to the browser.
# ------------------------------------------------------------

NEXT_PUBLIC_API_URL=http://localhost:8000


# ------------------------------------------------------------
# STRIPE  (billing)
#
# Test mode (no company registration needed):
#   STRIPE_SECRET_KEY = sk_test_...
#   Run: stripe listen --forward-to localhost:8000/billing/webhook
#   Copy the printed signing secret → STRIPE_WEBHOOK_SECRET
#
# Live mode (after company registration):
#   Swap sk_test_ → sk_live_ and create a webhook endpoint in the
#   Stripe Dashboard pointing to https://api.clewsec.com/billing/webhook
# ------------------------------------------------------------

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Recurring price IDs from Stripe Dashboard (Products → Prices)
# Create one INR price and one USD price per tier.
STRIPE_PRICE_STARTER_INR=
STRIPE_PRICE_STARTER_USD=
STRIPE_PRICE_GROWTH_INR=
STRIPE_PRICE_GROWTH_USD=
STRIPE_PRICE_PRO_INR=
STRIPE_PRICE_PRO_USD=
