# ============================================================
# Clew — environment variable reference
#
#   .env                 → Python backend (FastAPI + Celery workers)
#   frontend/.env.local  → Next.js frontend (NEXT_PUBLIC_* + JWT_SECRET)
#
# Copy this file to get started:
#   cp .env.example .env
# ============================================================


# ------------------------------------------------------------
# DEBUG
# ------------------------------------------------------------

# Set to 1 to enable /docs and /redoc (FastAPI auto-docs). Never set in production.
DEBUG=0


# ------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------

DATABASE_URL=postgresql://clew:your-db-password@localhost:5432/clew


# ------------------------------------------------------------
# REDIS  (Celery broker + rate-limit counters + LTM state)
# ------------------------------------------------------------

REDIS_URL=redis://localhost:6379/0


# ------------------------------------------------------------
# AUTH
# ------------------------------------------------------------

# JWT — generate with: openssl rand -hex 64
# Must be identical in .env AND frontend/.env.local
JWT_SECRET=change-me-to-64-random-hex-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Fernet key for encrypting TOTP secrets at rest
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=generate-a-fernet-key-here

# Dashboard base URL (used in emailed links to the app, Stripe/Razorpay return
# URLs, and CORS). The app lives at the root of the dashboard host, so links are
# built as {DASHBOARD_URL}/settings#billing (no /dashboard prefix).
# Local dev: http://dashboard.localhost:3000 | Production: https://dashboard.clewsec.com
DASHBOARD_URL=http://dashboard.localhost:3000

# Home (marketing) site base URL (newsletter confirm link and other marketing links in email)
# Local dev: http://localhost:3000 | Production: https://www.clewsec.com
HOME_URL=http://localhost:3000

# Cookie domain. Leave BLANK everywhere: auth cookies are host-only, set by the
# same host the browser is on (the browser reaches the API same-origin at /api).
COOKIE_DOMAIN=

# Transition only. Before the host split, production set COOKIE_DOMAIN=.clewsec.com,
# so browsers still hold auth cookies with that Domain. Set this to the old value
# (.clewsec.com) while users migrate: login and logout also emit a delete for that
# domain so the stale cookie cannot shadow the new host-only one. Remove it (and
# this note) in a later phase. Local dev: leave blank.
LEGACY_COOKIE_DOMAIN=

# Cloudflare Turnstile — CAPTCHA on registration (item 10/38). Secret key
# from the Turnstile dashboard; verified server-side in POST /auth/register.
TURNSTILE_SECRET_KEY=


# ------------------------------------------------------------
# AWS  (clew-server IAM user: WAF blocking + S3 backup, fallback path
# for orgs without a cross-account role, see api/aws.py)
# ------------------------------------------------------------

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1

# Phase 2: Clew's own 12-digit AWS account ID, shown to customers in the
# settings-page trust policy so they can grant Clew's account
# sts:AssumeRole on their own IAM role. Top-right of the AWS Console.
CLEW_AWS_ACCOUNT_ID=


# ------------------------------------------------------------
# EMAIL  (AWS SES via Resend)
# ------------------------------------------------------------

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Item 6d: newsletter signups (news.clewsec.com domain + a Segment must be
# set up in Resend first — Resend's Audiences model is deprecated, Segments
# replaced it). Leave blank to have POST /newsletter/subscribe fail clean
# with a 503 instead of guessing a segment.
RESEND_SEGMENT_ID=

# Set to 1 in local dev to print emails to the terminal instead of sending.
# Leave blank in production.
LOG_EMAILS=


# ------------------------------------------------------------
# CELERY WORKERS
# ------------------------------------------------------------

# Number of concurrent worker processes.
# t3.small (2 vCPU) → 4  |  t3.xlarge (4 vCPU) → 8
CELERY_CONCURRENCY=4


# ------------------------------------------------------------
# BILLING — Razorpay (INR customers — implement first)
# ------------------------------------------------------------

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Signing secret configured in the Razorpay dashboard's webhook settings,
# used to verify the X-Razorpay-Signature header (item 29).
RAZORPAY_WEBHOOK_SECRET=

# No Razorpay Plan IDs are needed: billing uses one-time Orders, and the
# amount is computed server-side from api/tiers.py (PLAN_PRICES_PAISE).


# ------------------------------------------------------------
# BILLING — Stripe (USD customers — implement after company registration)
# ------------------------------------------------------------

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Price IDs from Stripe Dashboard (Products → Prices)
STRIPE_PRICE_STARTER_INR=
STRIPE_PRICE_STARTER_USD=
STRIPE_PRICE_GROWTH_INR=
STRIPE_PRICE_GROWTH_USD=
STRIPE_PRICE_PRO_INR=
STRIPE_PRICE_PRO_USD=


# ------------------------------------------------------------
# GEOIP  (MaxMind GeoLite2 — download with scripts/download_geoip.sh)
# ------------------------------------------------------------

# Free license key from https://www.maxmind.com/en/geolite2/signup
# Used by scripts/download_geoip.sh and the monthly cron update.
MAXMIND_LICENSE_KEY=

# Item 32: paths to the .mmdb files. Defaults to detection/datasets/ if unset.
# Only override these if you've moved the files elsewhere.
# Do NOT leave GEOIP_MMDB_PATH= / GEOIP_ASN_DB_PATH= in as empty lines: only
# set them to a real path, or remove them entirely.


# ------------------------------------------------------------
# LLM  (Groq, Phase 3/item 33's Threat explanations, Growth tier and above)
# ------------------------------------------------------------

# API key from console.groq.com. Left blank, the product runs exactly as
# before: verdicts get the rule-based template explanation, no LLM call is
# ever made.
GROQ_API_KEY=
# OpenAI-compatible endpoint. Kept in env (not hardcoded) so a local Ollama
# or another provider is a config change, not a code change.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
# Kill switch (Phase 2). Only 1, true, yes or on enables any LLM call. Unset,
# empty or anything else disables it everywhere, whatever GROQ_API_KEY is. The
# LLM only writes the explanation text of a detected attack, never the verdict,
# and is capped per org per month (api/tiers.py LLM_CALL_CAPS).
LLM_ENABLED=true


# ------------------------------------------------------------
# MONITORING
# ------------------------------------------------------------

# Cronitor heartbeat URL — paste the monitor's "Ping URL" from cronitor.io
# If set, process_logs pings it after each successful scan cycle.
# Leave blank locally. In production, configure a 25-min window monitor.
CRONITOR_URL=

# ------------------------------------------------------------
# OPS PANEL METRICS  (Phase 7)
# ------------------------------------------------------------

# Fixed reporting rate, INR per 1 USD, used only for the combined INR figure
# on the internal metrics page and CSV. It is a reporting figure, not
# accounting. Stored on every daily metrics row, so a past day keeps the rate
# it was computed with. Missing or not a positive number: the page shows
# "rate not set" for the combined block only, the per-currency figures are
# unaffected. Set the real value yourself; 88 is a local dev placeholder.
METRICS_INR_PER_USD=88

# ADMIN_API_KEY: reserved for item 48 (internal ops panel, post-MVP). No
# route reads this yet, do not set it, an unused var that looks like a
# live credential is a trap.


# ------------------------------------------------------------
# OPTIONAL ENRICHMENT
# ------------------------------------------------------------

# AbuseIPDB — public IP reputation lookup (optional)
# Free API key at https://www.abuseipdb.com/register
ABUSEIPDB_API_KEY=
