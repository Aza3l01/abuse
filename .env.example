# ============================================================
# Clew — environment variable reference
#
#   .env                 → Python backend (FastAPI + Celery workers)
#   frontend/.env.local  → Next.js frontend (NEXT_PUBLIC_* + JWT_SECRET)
#
# Copy this file to get started:
#   cp .env.example .env
# ============================================================


# ------------------------------------------------------------
# DEBUG
# ------------------------------------------------------------

# Set to 1 to enable /docs and /redoc (FastAPI auto-docs). Never set in production.
DEBUG=0


# ------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------

DATABASE_URL=postgresql://clew:your-db-password@localhost:5432/clew


# ------------------------------------------------------------
# REDIS  (Celery broker + rate-limit counters + LTM state)
# ------------------------------------------------------------

REDIS_URL=redis://localhost:6379/0


# ------------------------------------------------------------
# AUTH
# ------------------------------------------------------------

# JWT — generate with: openssl rand -hex 64
# Must be identical in .env AND frontend/.env.local
JWT_SECRET=change-me-to-64-random-hex-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Fernet key for encrypting TOTP secrets at rest
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=generate-a-fernet-key-here

# Frontend base URL (used in email links and CORS)
# Local dev: http://localhost:3000 | Production: https://clewsec.com
FRONTEND_URL=http://localhost:3000

# Cookie domain — set in production so the auth cookie works across subdomains
# (api.clewsec.com sets the cookie, clewsec.com reads it)
# Local dev: leave blank  |  Production: .clewsec.com
COOKIE_DOMAIN=


# ------------------------------------------------------------
# AWS  (clew-server IAM user — WAF blocking + S3 backup)
# ------------------------------------------------------------

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1


# ------------------------------------------------------------
# EMAIL  (AWS SES via Resend)
# ------------------------------------------------------------

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Set to 1 in local dev to print emails to the terminal instead of sending.
# Leave blank in production.
LOG_EMAILS=


# ------------------------------------------------------------
# CELERY WORKERS
# ------------------------------------------------------------

# Number of concurrent worker processes.
# t3.small (2 vCPU) → 4  |  t3.xlarge (4 vCPU) → 8
CELERY_CONCURRENCY=4


# ------------------------------------------------------------
# BILLING — Razorpay (INR customers — implement first)
# ------------------------------------------------------------

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Plan IDs created in the Razorpay dashboard (Products → Plans)
RAZORPAY_PLAN_STARTER_MONTHLY_INR=
RAZORPAY_PLAN_STARTER_ANNUAL_INR=
RAZORPAY_PLAN_GROWTH_MONTHLY_INR=
RAZORPAY_PLAN_GROWTH_ANNUAL_INR=
RAZORPAY_PLAN_PRO_MONTHLY_INR=
RAZORPAY_PLAN_PRO_ANNUAL_INR=


# ------------------------------------------------------------
# BILLING — Stripe (USD customers — implement after company registration)
# ------------------------------------------------------------

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Price IDs from Stripe Dashboard (Products → Prices)
STRIPE_PRICE_STARTER_INR=
STRIPE_PRICE_STARTER_USD=
STRIPE_PRICE_GROWTH_INR=
STRIPE_PRICE_GROWTH_USD=
STRIPE_PRICE_PRO_INR=
STRIPE_PRICE_PRO_USD=


# ------------------------------------------------------------
# GEOIP  (MaxMind GeoLite2 — download with scripts/download_geoip.sh)
# ------------------------------------------------------------

# Free license key from https://www.maxmind.com/en/geolite2/signup
# Used by scripts/download_geoip.sh and the monthly cron update.
MAXMIND_LICENSE_KEY=


# ------------------------------------------------------------
# MONITORING
# ------------------------------------------------------------

# Cronitor heartbeat URL — paste the monitor's "Ping URL" from cronitor.io
# If set, process_logs pings it after each successful scan cycle.
# Leave blank locally. In production, configure a 25-min window monitor.
CRONITOR_URL=

# Internal ops panel — protects GET /admin/orgs and GET /admin/orgs/{id}
# Generate with: openssl rand -hex 32
ADMIN_API_KEY=


# ------------------------------------------------------------
# OPTIONAL ENRICHMENT
# ------------------------------------------------------------

# AbuseIPDB — public IP reputation lookup (optional)
# Free API key at https://www.abuseipdb.com/register
ABUSEIPDB_API_KEY=
