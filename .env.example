# ============================================================
# Clew — environment variable reference
# Copy the relevant section to the appropriate .env file.
#
#   engine/.env        → Python detection engine
#   frontend/.env.local → Next.js frontend (never committed)
# ============================================================


# ------------------------------------------------------------
# ENGINE  (engine/.env)
# ------------------------------------------------------------

# LLM provider — only one is needed at a time.
# Default: local Ollama (no key required, set base_url in code)
GEMINI_API_KEY=                  # Google Gemini (gemini-1.5-flash etc.)
OPENAI_API_KEY=                  # OpenAI (gpt-4o etc.)
ANTHROPIC_API_KEY=               # Anthropic (claude-3-5-sonnet etc.)

# AWS — read-only access to the customer S3 bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1

# Threat intelligence enrichment (optional)
ABUSEIPDB_API_KEY=               # https://www.abuseipdb.com/register

# Background task queue (Celery)
REDIS_URL=redis://localhost:6379/0

# Database (Postgres via SQLAlchemy)
DATABASE_URL=postgresql://clew:password@localhost:5432/clew


# ------------------------------------------------------------
# FRONTEND  (frontend/.env.local)
# ------------------------------------------------------------

# Public API base URL — consumed by the Next.js app
NEXT_PUBLIC_API_URL=http://localhost:8000

# Auth session secret (used by NextAuth or custom JWT signing)
SESSION_SECRET=change-me-to-a-long-random-string

# Stripe (for subscription billing — future)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
