# ============================================================
# Clew backend environment (FastAPI + Celery)
# Copy to .env and fill in. Frontend variables: frontend/.env.local
# ============================================================


# ------------------------------------------------------------
# DEBUG
# ------------------------------------------------------------

# 1 enables /docs and /redoc. Never set in production.
DEBUG=0


# ------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------

DATABASE_URL=postgresql://clew:your-db-password@localhost:5432/clew


# ------------------------------------------------------------
# REDIS  (Celery broker, rate limits, task state)
# ------------------------------------------------------------

REDIS_URL=redis://localhost:6379/0


# ------------------------------------------------------------
# AUTH
# ------------------------------------------------------------

# Generate with: openssl rand -hex 64. Must match JWT_SECRET in frontend/.env.local.
JWT_SECRET=change-me-to-64-random-hex-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Fernet key for TOTP secrets. Generate with:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=generate-a-fernet-key-here

# Dashboard base URL: email links, CORS and the Secure cookie flag.
DASHBOARD_URL=http://dashboard.localhost:3000

# Marketing site base URL: newsletter confirm link and marketing redirects.
HOME_URL=http://localhost:3000

# Cookies are host-only, leave blank.
COOKIE_DOMAIN=

# Transition only: lets logins clear old cookies set on .clewsec.com. Blank locally.
LEGACY_COOKIE_DOMAIN=

# Cloudflare Turnstile secret (backend only). Local dev: Cloudflare's always-pass test secret.
TURNSTILE_SECRET_KEY=


# ------------------------------------------------------------
# AWS  (clew-server IAM user: WAF blocking and S3 backup)
# ------------------------------------------------------------

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1

# Clew's own 12-digit AWS account ID, shown to customers in the IAM trust policy.
CLEW_AWS_ACCOUNT_ID=


# ------------------------------------------------------------
# EMAIL  (Resend)
# ------------------------------------------------------------

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Newsletter Segment ID in Resend. Blank makes /newsletter/subscribe return 503.
RESEND_SEGMENT_ID=

# 1 prints emails to the terminal instead of sending. Blank in production.
LOG_EMAILS=


# ------------------------------------------------------------
# CELERY WORKERS
# ------------------------------------------------------------

# Worker processes. t3.small: 4, t3.xlarge: 8.
CELERY_CONCURRENCY=4


# ------------------------------------------------------------
# BILLING: Razorpay (INR)
# ------------------------------------------------------------

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Signing secret from the Razorpay webhook settings (X-Razorpay-Signature).
RAZORPAY_WEBHOOK_SECRET=

# No plan IDs needed: billing uses one-time Orders priced from api/tiers.py.
# Referral credit, as a percent (0 to 100, default 100) of the referee's first payment (see api/referrals.py).
# REFERRAL_CREDIT_PCT=100


# ------------------------------------------------------------
# BILLING: Stripe (USD)
# ------------------------------------------------------------

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Price IDs from the Stripe dashboard (Products, Prices).
STRIPE_PRICE_BASIC_INR=
STRIPE_PRICE_BASIC_USD=
STRIPE_PRICE_GROWTH_INR=
STRIPE_PRICE_GROWTH_USD=
STRIPE_PRICE_PRO_INR=
STRIPE_PRICE_PRO_USD=


# ------------------------------------------------------------
# GEOIP  (MaxMind GeoLite2, download with scripts/download_geoip.sh)
# ------------------------------------------------------------

# Free license key from maxmind.com/en/geolite2/signup.
MAXMIND_LICENSE_KEY=

# Optional .mmdb paths, default to detection/datasets/. Set a real path or leave
# the lines out, never empty.
# GEOIP_MMDB_PATH=
# GEOIP_ASN_DB_PATH=


# ------------------------------------------------------------
# LLM  (Groq, threat explanations on Growth and above)
# ------------------------------------------------------------

# Key from console.groq.com. Blank: rule-based explanations, no LLM call.
GROQ_API_KEY=
# OpenAI-compatible endpoint, so another provider is a config change.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
# Kill switch: only 1, true, yes or on enables LLM calls.
LLM_ENABLED=true


# ------------------------------------------------------------
# MONITORING
# ------------------------------------------------------------

# Better Stack heartbeat URLs. Leave blank locally.
# HEARTBEAT_URL: poll_all_clients (15 min). BILLING_HEARTBEAT_URL: billing_cycle (daily).
HEARTBEAT_URL=
BILLING_HEARTBEAT_URL=

# PostHog EU project key (phc_...), never a personal key. Blank disables server events.
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com


# ------------------------------------------------------------
# OPS PANEL METRICS
# ------------------------------------------------------------

# INR per 1 USD for the combined figure on the metrics page. A reporting figure,
# not accounting. Missing or invalid: the combined block shows "rate not set".
METRICS_INR_PER_USD=88


# ------------------------------------------------------------
# OPTIONAL ENRICHMENT
# ------------------------------------------------------------

# AbuseIPDB IP reputation key
ABUSEIPDB_API_KEY=
