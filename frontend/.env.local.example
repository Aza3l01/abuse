# Next.js frontend environment variables
# Copy to frontend/.env.local (never commit .env.local)

# Hosts. In dev, marketing is http://localhost:3000 and the app is
# http://dashboard.localhost:3000 (browsers resolve *.localhost to 127.0.0.1).
# NEXT_PUBLIC_* values are baked at build time, so set them before `next build`.
#
# Browser-side API base. Same-origin /api: nginx maps it to FastAPI in production,
# and a dev-only rewrite in next.config.ts does it locally. Do not point this at
# http://localhost:8000 (that makes every call cross-origin).
NEXT_PUBLIC_API_URL=/api
# Absolute URLs used for links between the two hosts. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DASHBOARD_URL=http://dashboard.localhost:3000
# Production: https://www.clewsec.com and https://dashboard.clewsec.com

# Server-side only (read by src/proxy.ts, not exposed to the browser).
# Host header value that means "dashboard". Production: dashboard.clewsec.com
DASHBOARD_HOST=dashboard.localhost:3000
# Where marketing paths on the dashboard host redirect. Production: https://www.clewsec.com
MARKETING_URL=http://localhost:3000
# FastAPI address for the proxy's token refresh and the dev-only /api rewrite.
API_INTERNAL_URL=http://127.0.0.1:8000

# JWT secret — MUST match the JWT_SECRET in the backend .env exactly.
# Used by Next.js edge middleware to verify access tokens server-side without
# a round-trip to the API.  Generate with:  openssl rand -hex 32
JWT_SECRET=change-me-to-64-random-chars

# Cloudflare Turnstile — site key (public), pairs with backend TURNSTILE_SECRET_KEY.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

