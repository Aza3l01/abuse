# Next.js frontend environment variables
# Copy to frontend/.env.local (never commit .env.local)

# Hosts. These are the production values. For local dev use
# NEXT_PUBLIC_SITE_URL=http://localhost:3000 and
# NEXT_PUBLIC_DASHBOARD_URL=http://dashboard.localhost:3000 (browsers resolve
# *.localhost to 127.0.0.1).
# NEXT_PUBLIC_* values are baked at build time, so set them before `next build`.
#
# Browser-side API base. Same-origin /api: nginx maps it to FastAPI in production,
# and a dev-only rewrite in next.config.ts does it locally. Do not point this at
# http://localhost:8000 (that makes every call cross-origin).
NEXT_PUBLIC_API_URL=/api
# Absolute URLs used for links between the two hosts. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.clewsec.com
NEXT_PUBLIC_DASHBOARD_URL=https://dashboard.clewsec.com

# Server-side only (read by src/proxy.ts, not exposed to the browser).
# Host header value that means "dashboard". Local dev: dashboard.localhost:3000
DASHBOARD_HOST=dashboard.clewsec.com
# Host header value of the staff ops panel (Phase 6). Local dev: internal.localhost:3000
INTERNAL_HOST=internal.clewsec.com
# Where marketing paths on the dashboard host redirect. Local dev: http://localhost:3000
HOME_URL=https://www.clewsec.com
# FastAPI address for the proxy's token refresh and the dev-only /api rewrite.
API_INTERNAL_URL=http://127.0.0.1:8000

# JWT secret — MUST match the JWT_SECRET in the backend .env exactly.
# Used by Next.js edge middleware to verify access tokens server-side without
# a round-trip to the API.  Generate with:  openssl rand -hex 32
JWT_SECRET=change-me-to-64-random-chars

# Cloudflare Turnstile site key (public), pairs with backend TURNSTILE_SECRET_KEY.
# Local dev: Cloudflare's always-passes test key 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAEaBjOquCHKIsBAJ

# PostHog EU (Phase 11), public project key (phc_...). Blank disables analytics
# entirely, which is the right setting locally. Baked at build time.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Domain the analytics cookie is shared on, so a visitor keeps one identity
# across www and dashboard. Production: .clewsec.com. Leave blank locally.
NEXT_PUBLIC_COOKIE_DOMAIN=

