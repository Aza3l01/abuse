# ============================================================
# Clew frontend environment (Next.js)
# Copy to frontend/.env.local and fill in. Backend variables: .env
# NEXT_PUBLIC_* values are baked at build time: set them before `next build`.
# ============================================================


# ------------------------------------------------------------
# HOSTS
# ------------------------------------------------------------

# Browser API base. Keep same-origin /api (nginx in production, a rewrite in next.config.ts locally).
NEXT_PUBLIC_API_URL=/api

# Absolute URLs between the two hosts, no trailing slash.
# Local dev: http://localhost:3000 and http://dashboard.localhost:3000
NEXT_PUBLIC_SITE_URL=https://www.clewsec.com
NEXT_PUBLIC_DASHBOARD_URL=https://dashboard.clewsec.com

# Server side only (src/proxy.ts): Host header values for the dashboard and ops panel.
# Local dev: dashboard.localhost:3000 and internal.localhost:3000
DASHBOARD_HOST=dashboard.clewsec.com
INTERNAL_HOST=internal.clewsec.com

# Server side only: where marketing paths on the dashboard host redirect.
HOME_URL=https://www.clewsec.com

# Server side only: FastAPI address for token refresh and the dev /api rewrite.
API_INTERNAL_URL=http://127.0.0.1:8000


# ------------------------------------------------------------
# AUTH
# ------------------------------------------------------------

# Generate with: openssl rand -hex 64. Must match JWT_SECRET in the backend .env.
JWT_SECRET=change-me-to-64-random-hex-chars

# Cloudflare Turnstile site key (public). Pairs with TURNSTILE_SECRET_KEY in the backend .env.
# Local dev: Cloudflare's always-pass test site key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=


# ------------------------------------------------------------
# ANALYTICS
# ------------------------------------------------------------

# PostHog EU project key (phc_...). Blank disables analytics.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Analytics cookie domain, shared across www and dashboard. Production: .clewsec.com. Blank locally.
NEXT_PUBLIC_COOKIE_DOMAIN=

